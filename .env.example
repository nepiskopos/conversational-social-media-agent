# Web search (required)
TAVILY_API_KEY=tvly-...

# ── LLM provider ─────────────────────────────────────────────────────────────
# Configure at least one provider below. A provider is used when its key (and,
# for self-hosted endpoints, its URL) is set. With several configured, the
# first in this order is the main model and the others are automatic fallbacks:
#   custom (LLM_MODEL) > Anthropic > OpenAI > xAI > Google > Mistral > Groq >
#   DeepSeek > OpenRouter > OpenCode Zen > Qwen (self-hosted vLLM)
# LLM_PROVIDER picks the main one instead, by id:
#   anthropic | openai | xai | google | mistral | groq | deepseek | openrouter |
#   opencode | qwen | custom
LLM_PROVIDER=

# Each *_MODEL is optional — leave blank for the default shown.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
XAI_API_KEY=
XAI_MODEL=xai/grok-3-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-2.0-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenCode Zen (OpenAI-compatible, paid: the account needs credit). Free models
# (*-free, big-pickle) only answer the OpenCode app itself and refuse other clients.
# Any Chat Completions model works.
OPENCODE_API_KEY=
OPENCODE_MODEL=glm-5.3-flash
OPENCODE_BASE_URL=            # blank = https://opencode.ai/zen/v1

# Qwen on a self-hosted vLLM server (OpenAI-compatible). Both URL and key needed.
# From inside Docker, a server on this machine is http://host.docker.internal:PORT/v1
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=qwen36-35b-a3b

# Anything else LiteLLM supports (Azure, Bedrock, Vertex, Ollama, Together, ...):
# a full LiteLLM model string, plus an endpoint and key when the provider needs them.
# e.g. LLM_MODEL=ollama_chat/llama3.1  LLM_API_BASE=http://localhost:11434
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY=

# ── Optional cost routing and eval judge (unset = main model) ────────────────
# Use the full LiteLLM string, e.g. groq/llama-3.1-8b-instant, or a bare name
# with *_PROVIDER set; the provider must be configured above.
# FAST_MODEL: cheaper model for background work (summaries, org brief, calendar).
# JUDGE_MODEL: model that grades scripts/eval.py runs — ideally another provider, or at
# least another model family. On OpenCode Zen only Chat Completions models work
# (e.g. openai/deepseek-v4-pro, openai/kimi-k3); its Claude, GPT and Gemini models don't.
# FAST_PROVIDER / JUDGE_PROVIDER: optional provider id for that model, for a model
# string two configured providers accept: with OPENAI_API_KEY and OPENCODE_API_KEY
# both set, openai/... goes to OpenAI unless the provider is opencode. Set alone,
# the provider's own model is used (e.g. JUDGE_PROVIDER=groq).
FAST_MODEL=
FAST_PROVIDER=
JUDGE_MODEL=
JUDGE_PROVIDER=
