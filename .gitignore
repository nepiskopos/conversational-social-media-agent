# Secrets: real keys live only in .env (and any local variant); the template is committed
.env
.env.*
!.env.example

# Org data from before PostgreSQL (profiles, traces, the SQLite conversation database),
# kept until scripts/import_profiles.py has moved it.
data/*
!data/.gitkeep

# Chainlit uploaded-files cache (.chainlit/config.toml and translations are committed)
.files/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test, lint and coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Browser tests (tests/browser): Playwright traces, screenshots and reports, if enabled
test-results/
playwright-report/

# Claude Code: personal settings, notes and worktrees (a shared .claude/settings.json is fine to commit)
.claude/settings.local.json
.claude/*.lock
.claude/worktrees/
CLAUDE.local.md

# Logs
*.log

# Editors and operating systems
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
**Zone.Identifier
