# Secrets: real keys live only in .env (and any local variant); the template is committed
.env
.env.*
!.env.example

# Runtime data: org profiles (+ .bak), per-org .lock files and write temp files, traces,
# the SQLite conversation database.
# Keep the empty folder so `docker compose` mounts a user-owned ./data, not one Docker creates as root.
data/*
!data/.gitkeep

# Chainlit uploaded-files cache (.chainlit/config.toml and translations are committed)
.files/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test, lint and coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Browser tests (tests/browser): Playwright traces, screenshots and reports, if enabled
test-results/
playwright-report/

# Claude Code: personal settings, notes and worktrees (a shared .claude/settings.json is fine to commit)
.claude/settings.local.json
.claude/*.lock
.claude/worktrees/
CLAUDE.local.md

# Logs
*.log

# Editors and operating systems
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
**Zone.Identifier
